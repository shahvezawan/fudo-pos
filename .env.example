DATABASE_URL=postgresql://fudo:CHANGE_ME@127.0.0.1:5432/fudo
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
# Required only for first owner setup; remove after setup.
SETUP_TOKEN=replace-with-a-long-random-secret
# Absolute path to a SECOND drive or network share; do not use the database drive.
BACKUP_DIR=D:\FudoBackups
PG_BIN=C:\Program Files\PostgreSQL\17\bin
# Set true when serving behind an HTTPS reverse proxy.
COOKIE_SECURE=false
